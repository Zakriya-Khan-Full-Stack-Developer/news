# Production Base URL
NEXT_PUBLIC_SITE_URL=https://nameverse.site

# Canonical host. Every other host this project is reachable on (www.*,
# *.vercel.app, and anything listed in LEGACY_HOSTS) is 301-redirected here by
# middleware.js. See MIGRATION-INDEXING-DIAGNOSIS.md.
NEXT_PUBLIC_CANONICAL_HOST=nameverse.site

# ── Migration: the host you moved FROM ────────────────────────────────────────
# Comma-separated, lowercase, no scheme, no trailing slash.
# Set this to the subdomain the site used to live on. Until it is set, that host
# keeps serving 200s and Google sees two competing copies of every page —
# which is why the new domain is not indexing.
LEGACY_HOSTS=

# Google AdSense native ad config
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=
NEXT_PUBLIC_GOOGLE_ADSENSE_SLOT=
