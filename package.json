{
  "name": "nameverse",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/generate-manifest.mjs && node scripts/generate-search-index.mjs && node scripts/verify-content.mjs && node scripts/verify-uniqueness.mjs",
    "dev": "next dev",
    "build": "node --max-old-space-size=1536 ./node_modules/next/dist/bin/next build",
    "postbuild": "node scripts/verify-static.mjs",
    "prune": "node scripts/prune-build-assets.mjs",
    "verify": "node scripts/verify-content.mjs && node scripts/verify-uniqueness.mjs",
    "start": "next start",
    "lint": "eslint app components lib scripts src --ext .js,.jsx,.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "next": "^15.5.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.10.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.14"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
